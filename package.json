{
	"name": "mvox",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "scripts/install-hooks.sh && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run && playwright test",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"lint": "biome check . && eslint .",
		"lint:fix": "biome check --write . && eslint --fix .",
		"format": "biome format --write .",
		"i18n:gen": "vite build",
		"deploy": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare --project-name multivox",
		"migrate:phase-a": "tsx scripts/migrations/2026-05-19-phase-a.ts",
		"migrate:phase-a:dry": "tsx scripts/migrations/2026-05-19-phase-a.ts --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@inlang/paraglide-sveltekit": "^0.16.1",
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.9.0",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"eslint": "^10.4.0",
		"eslint-plugin-svelte": "^3.17.1",
		"happy-dom": "^20.9.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.6.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^3.0.0"
	}
}
