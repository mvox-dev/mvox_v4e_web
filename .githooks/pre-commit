#!/usr/bin/env bash
# pre-commit — branch-intent verifier (mvox-dev shared-tree defense)
#
# Honors the OPTIONAL environment variable MVOX_EXPECTED_BRANCH. If set and
# non-empty, the hook rejects the commit when its value doesn't match the
# current branch. Unset / empty = no-op (humans default to no-op).
#
# Agents (and team-lead) declare intent per-commit:
#   MVOX_EXPECTED_BRANCH=main git commit -m "..."
#   MVOX_EXPECTED_BRANCH=chore/navbar-auth-wiring git commit -m "..."
#
# Or export once per shell session:
#   export MVOX_EXPECTED_BRANCH=main
#   git commit -m "..."
#
# No file writes, no .git/ access, no per-clone bootstrap. Works under any
# tool-permission allowlist that lets the agent run git itself.
#
# Rationale: session-22 logged three branch-flip incidents on a shared working
# tree where team-lead or agent commits landed on the wrong branch. See
# architecture-decisions.md and feedback_no_parallel_branches in the
# auto-memory layer.

set -e

EXPECTED="${MVOX_EXPECTED_BRANCH:-}"

# No declaration → no opinion. Allow.
if [ -z "$EXPECTED" ]; then
	exit 0
fi

CURRENT=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Detached HEAD → reject (declared intent but no branch to compare).
if [ -z "$CURRENT" ]; then
	cat >&2 <<EOF

✗ BRANCH MISMATCH — commit aborted (detached HEAD)

  Expected branch: $EXPECTED  (from \$MVOX_EXPECTED_BRANCH)
  Current state:   detached HEAD

  Declared intent says you intended to commit to '$EXPECTED' but HEAD is
  not on any branch. Either checkout '$EXPECTED' or unset the env var.

EOF
	exit 1
fi

if [ "$EXPECTED" != "$CURRENT" ]; then
	cat >&2 <<EOF

✗ BRANCH MISMATCH — commit aborted

  Expected branch: $EXPECTED  (from \$MVOX_EXPECTED_BRANCH)
  Current branch:  $CURRENT  (HEAD)

  \$MVOX_EXPECTED_BRANCH says you intended to commit to '$EXPECTED' but
  HEAD is on '$CURRENT'. This protects against shared-tree branch flips
  (session-22 incidents on mvox-dev).

  To proceed, either:
    1. Switch branches first:    git checkout $EXPECTED
    2. Update the declaration:   export MVOX_EXPECTED_BRANCH=$CURRENT
    3. Unset the declaration:    unset MVOX_EXPECTED_BRANCH

EOF
	exit 1
fi

exit 0
